# Servidor da tela do NetWatch (gerado a partir deste modelo pelo nginx ao iniciar).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # API e saúde: encaminhadas para a NetWatch API (mesma origem, sem CORS).
    location /api/ {
        proxy_pass http://${NETWATCH_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /actuator/ {
        proxy_pass http://${NETWATCH_API_UPSTREAM};
    }

    # Arquivos com hash no nome: cache longo.
    location ~* \.(js|css|woff2?|svg|png|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Rotas do Angular (ex.: /devices/123): sempre o index.html.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
}
