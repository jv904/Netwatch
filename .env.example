# Copie para .env (mesma pasta do docker-compose.yml) e ajuste.

# Portas no seu computador
NETWATCH_WEB_PORT=4200
NETWATCH_API_PORT=8080

# Rede(s) que o NetWatch pode verificar, separadas por vírgula (somente faixas privadas)
NETWATCH_DISCOVERY_AUTHORIZED_NETWORKS=192.168.100.0/24

# Senha do banco do Docker (troque antes de usar fora do seu computador)
NETWATCH_DB_PASSWORD=netwatch

# Fuso horário dos relatórios e do horário das atividades
TZ=America/Sao_Paulo
